{
  "name": "tv-app-client",
  "description": "Cross-platform IPTV Application",
  "author": "Sooraj",
  "private": true,
  "version": "0.0.0",
  "main": "electron/build/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:start": "electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on tcp:5173 && npm run electron:build && cross-env NODE_ENV=development npm run electron:start\"",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "build:win": "npm run build && npm run electron:build && electron-builder --win",
    "build:linux": "npm run build && npm run electron:build && electron-builder --linux",
    "build:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "hls.js": "^1.6.15",
    "idb": "^8.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}